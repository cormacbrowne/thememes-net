      "destination": "/api/meme-og?id=:id"
    },
    {
      "source": "/u/:handle",
      "destination": "/api/creator-og?handle=:handle"
    },
    {
      "source": "/:section(admin|administrator|moderator|moderation)",
      "destination": "/"
    },
    {
      "source": "/:section(admin|administrator)/:rest*",
      "destination": "/"
    },
    {
      "source": "/((?!_vercel/|api/|assets/|seed/|favicon|logo-|apple-touch-icon|manifest\\.webmanifest|BingSiteAuth\\.xml|5eed15f774c2bb475174d8b3153e9496\\.txt).*)",
      "destination": "/api/not-found"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://plausible.io https://va.vercel-scripts.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://otvvphmjojqyjaznjzyo.supabase.co; media-src 'self' data: blob: https://otvvphmjojqyjaznjzyo.supabase.co; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://plausible.io https://otvvphmjojqyjaznjzyo.supabase.co wss://otvvphmjojqyjaznjzyo.supabase.co https://vitals.vercel-insights.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none';"
        }
      ]
    },
